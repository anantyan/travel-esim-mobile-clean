{
  "name": "travel-esim-mobile-clean",
  "version": "0.1.0",
  "private": false,
  "description": "Ultra-Low Browser RAM Mobile-First Clean Architecture Boilerplate (React 19, Vite 6, TanStack Router/Query/Virtual, Zustand 5) — Travel eSIM Case Study",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "@hookform/resolvers": "^5.0.1",
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-query": "^5.74.3",
    "@tanstack/react-router": "^1.114.3",
    "@tanstack/react-virtual": "^3.13.6",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tanstack/router-plugin": "^1.114.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^3.1.2"
  }
}
